# Web3Forms access key for the landing page's pilot-request form.
# Create one (free) at https://web3forms.com by entering the inbox that should
# receive submissions — the key is public-safe and hides the email address.
# Copy this file to .env.local and fill in:
NEXT_PUBLIC_WEB3FORMS_KEY=

# Base URL of the venue content server (defaults to http://localhost:4000).
# NEXT_PUBLIC_VENUE_API=
